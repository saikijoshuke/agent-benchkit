# ===== 必填 =====
DEEPSEEK_API_KEY=sk-你的DeepSeek真实Key

# ===== 检索后端切换 =====
# serpapi 或 tavily。二选一，对应下方凭据二选一填写。
SEARCH_BACKEND=serpapi

# —— SerpAPI（backend=serpapi 时必填）——
SERPAPI_API_KEY=你的SerpAPI真实Key
SERPAPI_ENGINE=google          # 可选：google / bing / baidu / duckduckgo / yahoo 等
SERPAPI_MAX_RESULTS=8

# —— Tavily（backend=tavily 时必填，与上面二选一）——
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=8

# ===== 抗幻觉 / 抗引用造假（核心）=====
# 要求模型只引用检索来源编号（[1][2]），杜绝编造 URL
GROUNDED_CITATION=1
# 生成后二次校验并裁剪编造引用
POST_VERIFY_CITATIONS=1
# 是否对引用 URL 做真实可达性探测（需联网；关闭则只做"是否在检索结果内"判定）
VERIFY_URL_REACHABLE=0
# 事实合成温度（越低越稳）
SYNTH_TEMPERATURE=0.1
PLAN_TEMPERATURE=0.2

# ===== 架构开关 =====
ENABLE_PARALLEL=1
PARALLEL_WORKERS=5
ENABLE_CREDIBILITY=1
# 反思循环代价较高，默认关闭；需要极致严谨时置 1
ENABLE_REFLECTION=0
REFLECTION_ROUNDS=1

# ===== 缓存 / 成本 =====
ENABLE_CACHE=1
CACHE_DIR=cache

# ===== 可选：Langfuse 链路追踪 =====
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== 检索超时（秒）=====
REQUEST_TIMEOUT=15
